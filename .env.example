# ─── Aegis Trading — environment configuration ────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`. Secrets are read only by backend
# services and are never sent to the browser.

# ── Security (required) ──────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
# at least 12 characters
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Origin(s) the dashboard is served from, comma separated (also enforced for WebSockets)
CORS_ORIGINS=http://localhost:8080
# Optional comma separated CIDR allowlist for the API, e.g. 203.0.113.7/32
ALLOWED_IPS=
# Host interface the dashboard binds to. Keep 127.0.0.1 and use an SSH tunnel or the TLS profile.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
# Only for the optional `tls` profile (Caddy + Let's Encrypt)
DOMAIN=

# ── LLM providers (at least one key is required for agents to run) ────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# xAI Grok: https://console.x.ai
XAI_API_KEY=
XAI_DEFAULT_MODEL=grok-3-mini
# Any other OpenAI-compatible endpoint (OpenRouter, Together, self-hosted vLLM, ...)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_DEFAULT_MODEL=
# Provider used by agents without an explicit override: openai | xai | custom
LLM_DEFAULT_PROVIDER=openai
# Per-agent override, format provider:model  (also editable in the dashboard)
AGENT_SCOUT_MODEL=
AGENT_NEWS_MODEL=
AGENT_TECHNICAL_MODEL=
AGENT_ANALYST_MODEL=
AGENT_SKEPTIC_MODEL=
AGENT_RISK_MANAGER_MODEL=
# Cost controls
LLM_DAILY_CALL_BUDGET=2000
CYCLE_INTERVAL_SECONDS=900
MAX_CANDIDATES_PER_CYCLE=2

# ── Trading mode ─────────────────────────────────────────────────────────────
# paper   = real market data, simulated fills (default)
# testnet = real orders on Binance Spot Testnet (needs the keys below)
TRADING_MODE=paper
# Binance Spot Testnet keys: https://testnet.binance.vision  (log in with GitHub -> Generate HMAC key)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Public market data endpoint. If api.binance.com is geo-blocked from your VPS use
# https://data-api.binance.vision (REST) and wss://data-stream.binance.vision (WS).
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
# Extra base assets to keep out of the tracked universe (comma separated), e.g. tokenised stocks
UNIVERSE_EXCLUDE=

# Live trading is a future milestone and stays OFF. All four values are required
# server-side before the engine will even construct a live adapter.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# ── Risk defaults (editable at runtime in the dashboard, within hard bounds) ──
STARTING_CAPITAL=1000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_EXPOSURE_PCT=30.0
MAX_OPEN_POSITIONS=5
MIN_RISK_REWARD=2.0
FEE_RATE=0.001
SLIPPAGE_BPS=5

# ── News / sentiment (optional) ──────────────────────────────────────────────
CRYPTOPANIC_API_KEY=

# ── Notifications (optional) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

LOG_LEVEL=INFO
